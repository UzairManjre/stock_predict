# Database settings read by every script. setup.ps1 copies this file to .env.
# These defaults match the portable PostgreSQL that setup.ps1 installs. If you use your own
# PostgreSQL server instead, change them here (a normal Windows install listens on port 5432).
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stock_predict
